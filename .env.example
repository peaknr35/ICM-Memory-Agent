# Copy this file to `.env` and fill in only the keys you use.
# `.env` is gitignored — never commit real keys, and never paste them into chat.
# Check your setup with:  python -m runtime.check        (add --live for one tiny real call each)

# Claude (reasoning).            Get a key: Claude Console -> API keys.   Also needs: pip install anthropic
# ANTHROPIC_API_KEY=

# Gemini (reasoning + embeddings, one key).   Get a key: Google AI Studio -> Get API key
# GEMINI_API_KEY=

# Voyage (embeddings only; the Anthropic-recommended embeddings provider).   Get a key: Voyage AI dashboard
# VOYAGE_API_KEY=

# Which backends to use. Defaults are fully offline: stub + hash.
# MEMORY_LLM_BACKEND=claude          # stub | ollama | claude | gemini
# MEMORY_EMBED_BACKEND=gemini        # hash | keyword | ollama | gemini | voyage | sentence-transformers

# Optional model overrides (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# VOYAGE_MODEL=voyage-4
# OLLAMA_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text
