# Required
OPENAI_API_KEY=          # embeddings (text-embedding-3-small)
ANTHROPIC_API_KEY=       # Slack thread distillation + `ask` synthesis

# Per source (only the ones you enable in config.json)
SLACK_USER_TOKEN=        # xoxp-... (or SLACK_BOT_TOKEN=xoxb-...)
YOUTUBE_API_KEY=         # YouTube Data API v3 key
# GitHub uses the `gh` CLI login — run `gh auth login` once.
